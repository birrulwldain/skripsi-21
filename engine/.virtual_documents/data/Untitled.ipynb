import sqlite3

def check_db_structure(db_file_path):
    """
    Menghubungkan ke file SQLite .db dan mencetak struktur database:
    daftar tabel dan skema untuk setiap tabel.

    Args:
        db_file_path (str): Jalur lengkap ke file database .db.
    """
    conn = None
    try:
        conn = sqlite3.connect(db_file_path)
        cursor = conn.cursor()

        print(f"Memeriksa struktur database: {db_file_path}\n")

        # 1. Dapatkan daftar semua tabel
        cursor.execute("SELECT name FROM sqlite_master WHERE type='table';")
        tables = cursor.fetchall()

        if not tables:
            print("Tidak ada tabel ditemukan di database ini.")
            return

        print("Tabel yang ditemukan:")
        for table_name_tuple in tables:
            table_name = table_name_tuple[0]
            print(f"- {table_name}")

        print("\n--- Skema Tabel ---")
        # 2. Dapatkan skema untuk setiap tabel
        for table_name_tuple in tables:
            table_name = table_name_tuple[0]
            print(f"\nSkema untuk tabel '{table_name}':")
            # PRAGMA table_info(tablename) mengembalikan informasi tentang setiap kolom
            cursor.execute(f"PRAGMA table_info({table_name});")
            columns = cursor.fetchall()

            if not columns:
                print(f"  Tidak ada kolom ditemukan di tabel '{table_name}'.")
                continue

            # Cetak header kolom untuk informasi skema
            print(f"  {'CID':<4} {'Nama':<20} {'Tipe':<15} {'NULL?':<7} {'Default':<10} {'PK':<3}")
            print(f"  {'-'*4:<4} {'-'*20:<20} {'-'*15:<15} {'-'*7:<7} {'-'*10:<10} {'-'*3:<3}")

            for col in columns:
                cid, name, col_type, not_null, default_value, primary_key = col
                print(f"  {cid:<4} {name:<20} {col_type:<15} {'YES' if not_null == 0 else 'NO':<7} {str(default_value):<10} {primary_key:<3}")

    except sqlite3.Error as e:
        print(f"Terjadi kesalahan SQLite: {e}")
    except FileNotFoundError:
        print(f"Error: File database tidak ditemukan di '{db_file_path}'")
    except Exception as e:
        print(f"Terjadi kesalahan tak terduga: {e}")
    finally:
        if conn:
            conn.close()
            print("\nKoneksi database ditutup.")

